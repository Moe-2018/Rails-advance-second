<%= form_with model: @event, class: "space-y-6 w-3/4 max-w-lg bg-white p-6 rounded-lg shadow" do |f| %>
  
 
  <div class="mt-1">
    <label class="text-gray-700 text-lg">
      イベントタイトル
    </label>
    <%= f.text_field :title, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 mt-1 py-1 px-2 block w-full sm:text-sm placeholder-gray-400 border border-gray-300 rounded-md", placeholder: "就活支援イベント" %>
  </div>
 
  <div class="mt-1">
    <label class="text-gray-700 text-lg">
      説明
    </label>
    <%= f.text_area :description, rows: "4", class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 mt-1 py-1 px-2 block w-full sm:text-sm placeholder-gray-400 border border-gray-300 rounded-md", placeholder: "イベントの詳細を入力してください" %>
  </div>
 
 <div class="mt-1">
    <label class="text-gray-700 text-lg">
      開催日時
    </label>
    <%= f.datetime_field :start_date, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 mt-1 py-1 px-2 block w-full sm:text-sm placeholder-gray-400 border border-gray-300 rounded-md" %>
  </div>

  <div class="mt-1">
    <label class="text-gray-700 text-lg">
      主催者名
    </label>
    <%= f.text_field :organiser_name, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 mt-1 py-1 px-2 block w-full sm:text-sm placeholder-gray-400 border border-gray-300 rounded-md", placeholder: "山田太郎" %>
  </div>

  <div class="mt-1">
    <label class="text-gray-700 text-lg">
      対象部署
    </label>
    <%= f.text_field :target_department, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 mt-1 py-1 px-2 block w-full sm:text-sm placeholder-gray-400 border border-gray-300 rounded-md", placeholder: "人事部" %>
  </div>

<%# 下記AI参考 %>
  <div class="pt-8 flex items-center justify-between border-t border-gray-100">
  <div>
    <%= link_to events_path, class: "flex items-center text-gray-500 hover:text-gray-700 transition duration-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"> 
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="10 19l-7-7m0 0l7-7m-7 7h18" /> 
      </svg> 
      一覧に戻る
    <% end %>
  </div> 
  
 
  <div class="px-4 py-3 text-right sm:px-6">
    <%= f.submit "登録する", class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 hover:cursor-pointer" %>
  </div>
<% end %>