<div class="space-y-6 w-3/4 max-w-lg">
  <label class="block text-xl font-bold text-gray-700">イベント詳細</label>
 
  <div class="items-center justify-center">
    <div class="focus:outline-none mb-7 bg-white p-6 shadow rounded">
      <div class="flex items-center border-b border-gray-200 pb-6">
        <div class="flex items-start justify-between w-full">
          <div class="pl-3">
              <p class="focus:outline-none text-lg font-medium leading-5 text-gray-800"><%= @event.title %></p>
              <p class="focus:outline-none text-sm leading-normal pt-2 text-gray-500">投稿者 : <%= @event.user.fullname %></p>
            </div>
          </div>
        </div>

        <% if user_signed_in? %>
              <% if @event.user_id == current_user.id %>
                <%= link_to "編集", edit_event_path(@event), class: "text-sm bg-transparent hover:bg-green-500 text-green-700 hover:text-white py-1 px-3 border border-green-500 hover:border-transparent rounded cursor-pointer mr-2" %>
                
                <%= button_to "削除", event_path(@event), method: :delete, class: "text-sm bg-transparent hover:bg-blue-500 text-blue-700 hover:text-white py-1 px-3 border border-blue-500 hover:border-transparent rounded hover:cursor-pointer" %>
              <% end %>
            <% end %>

        <div class="px-2">
          <p class="focus:outline-none text-sm leading-5 py-4 text-gray-600">説明 : <%= @event.description %></p>
        </div>
        <div class="px-2">
          <p class="focus:outline-none text-sm leading-5 py-4 text-gray-600">開催日時 : <%= @event.start_date %></p>
          <div class="px-2">
          <p class="focus:outline-none text-sm leading-5 py-4 text-gray-600">主催者 : <%= @event.organiser_name %></p>
        </div>
        <div class="px-2">
          <p class="focus:outline-none text-sm leading-5 py-4 text-gray-600">対象部署 : <%= @event.target_department %></p>
        </div>
        </div>
      </div>
  </div>
</div>